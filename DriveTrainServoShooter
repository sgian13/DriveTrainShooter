//ΒΑΣΙΚΟ DRIVETRAIN ΠΡΟΓΡΑΜΜΑ
package org.firstinspires.ftc.teamcode;

import android.annotation.SuppressLint;

import com.arcrobotics.ftclib.hardware.motors.Motor;
import com.arcrobotics.ftclib.drivebase.MecanumDrive;

import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.Servo;
import com.qualcomm.hardware.rev.RevHubOrientationOnRobot;
import com.qualcomm.robotcore.hardware.IMU;
import com.qualcomm.robotcore.util.ElapsedTime;

import org.firstinspires.ftc.robotcore.external.navigation.AngleUnit;
import org.firstinspires.ftc.robotcore.external.navigation.CurrentUnit;

// =========================
// ΚΟΥΜΠΙΑ: LB -> SHOOTER LEFT ON/OFF + ΠΑΡΑΚΟΛΟΥΘΗΣΗ (ticks, rpm)
//          RB -> SHOOTER RIGHT ON/OFF
//          A SLOW MODE
//          Y FIELD ORIENTED / ROBOT ORIENTED
//          X INTAKE
// =========================

@TeleOp(name = "Grobo-DriveTrain_Shooter_Servo")
public class DriveTrainServoShooter extends LinearOpMode {

    @SuppressLint("DefaultLocale")
    @Override
    public void runOpMode() {

        // =========================
        // FIELD / ROBOT CENTRIC
        // =========================

        boolean fieldCentric = false;
        boolean lastY = false;


        // =========================
        // INTAKE (Expansion Hub - Port 0)
        // =========================

        boolean intakeOn = false;
        boolean lastX = false;


        // =========================
        // SHOOTERS (toggle ON/OFF)
        // LB -> shooterLeft (με παρακολούθηση)
        // RB -> shooterRight
        // =========================

        boolean shooterLeftOn = false;
        boolean lastRB = false;

        boolean shooterRightOn = false;
        boolean lastLB = false;

        // Ισχύς των shooter όταν είναι ON
        final double SHOOTER_POWER = 1.0;

        // Ticks ανά περιστροφή του encoder (άλλαξέ το ανάλογα με το motor σου)
        final double SHOOTER_TICKS_PER_REV = 28;

        // --- Παρακολούθηση shooter left ---
        // Χρόνος από τη στιγμή που άνοιξε το shooter
        ElapsedTime shooterLeftTimer = new ElapsedTime();
        // Μέγιστα που έχουν καταγραφεί σε αυτό το ON
        double shooterLeftPeakRpm = 0;
        double shooterLeftPeakCurrent = 0;
        // Ticks τη στιγμή που άνοιξε (για να βλέπεις πόσα ticks έκανε από το ON)
        int shooterLeftStartTicks = 0;
        // Χρόνος που έφτασε το 95% του peak (spin-up time)
        double shooterLeftSpinUpTime = -1;


        // =========================
        // SERVOS (D-PAD - κάθε βελάκι κουνάει ΕΝΑ servo)
        // UP -> servo1
        // DOWN -> servo2
        // RIGHT -> servo3
        // LEFT -> servo4
        // Κάθε πάτημα αλλάζει το servo ανάμεσα σε REST <-> ACTIVE
        // =========================

        final double SERVO_REST = 0.1;
        final double SERVO_ACTIVE = 0.9;

        boolean servo1Active = false;
        boolean servo2Active = false;
        boolean servo3Active = false;
        boolean servo4Active = false;

        boolean lastUp = false;
        boolean lastDown = false;
        boolean lastRight = false;
        boolean lastLeft = false;


        // =========================
        // SLOW MODE (B - toggle ON/OFF)
        // =========================

        boolean slowMode = false;
        boolean lastB = false;

        // Ταχύτητα κίνησης (μπρος/πίσω/strafe) στο slow mode
        final double SLOW_DRIVE = 0.30;

        // Ταχύτητα στροφής στο slow mode
        final double SLOW_TURN = 0.30;


        // =========================
        // MOTORS (Control Hub)
        // =========================

        Motor frontLeft = new Motor(
                hardwareMap,
                "leftFMotor"
        );

        Motor frontRight = new Motor(
                hardwareMap,
                "rightFMotor"
        );

        Motor backLeft = new Motor(
                hardwareMap,
                "leftBMotor"
        );

        Motor backRight = new Motor(
                hardwareMap,
                "rightBMotor"
        );


        // =========================
        // INTAKE MOTOR
        // =========================

        DcMotor intakeMotor = hardwareMap.get(
                DcMotor.class,
                "intakeMotor"
        );

        intakeMotor.setDirection(DcMotorSimple.Direction.REVERSE);

        intakeMotor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        intakeMotor.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        intakeMotor.setPower(0);


        // =========================
        // SHOOTER MOTORS
        // =========================

        DcMotorEx shooterLeft = hardwareMap.get(
                DcMotorEx.class,
                "shooterLeft"
        );

        DcMotor shooterRight = hardwareMap.get(
                DcMotor.class,
                "shooterRight"
        );

        shooterLeft.setDirection(DcMotorSimple.Direction.REVERSE);
        shooterRight.setDirection(DcMotorSimple.Direction.REVERSE);

        // RUN_WITHOUT_ENCODER = το power 1.0 δίνει πλήρη τάση στο motor (χωρίς velocity PID).
        // Το encoder συνεχίζει να διαβάζει ticks/RPM κανονικά.
        shooterLeft.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        shooterRight.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);

        shooterLeft.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
        shooterRight.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);

        shooterLeft.setPower(0);
        shooterRight.setPower(0);


        // =========================
        // SERVOS
        // =========================

        Servo servo1 = hardwareMap.get(Servo.class, "servo1");
        Servo servo2 = hardwareMap.get(Servo.class, "servo2");
        Servo servo3 = hardwareMap.get(Servo.class, "servo3");
        Servo servo4 = hardwareMap.get(Servo.class, "servo4");

        // Αν κάποιο servo κουνιέται ανάποδα, βάλε REVERSE εδώ
        servo1.setDirection(Servo.Direction.FORWARD);
        servo2.setDirection(Servo.Direction.FORWARD);
        servo3.setDirection(Servo.Direction.FORWARD);
        servo4.setDirection(Servo.Direction.FORWARD);

        servo1.setPosition(SERVO_REST);
        servo2.setPosition(SERVO_REST);
        servo3.setPosition(SERVO_REST);
        servo4.setPosition(SERVO_REST);


        // =========================
        // MECANUM DRIVE
        // =========================

        MecanumDrive drive = new MecanumDrive(
                frontLeft,
                frontRight,
                backLeft,
                backRight
        );

        // =========================
        // IMU
        // =========================

        IMU imu = hardwareMap.get(
                IMU.class,
                "imu"
        );

        RevHubOrientationOnRobot.LogoFacingDirection logoDirection =
                RevHubOrientationOnRobot.LogoFacingDirection.UP;

        RevHubOrientationOnRobot.UsbFacingDirection usbDirection =
                RevHubOrientationOnRobot.UsbFacingDirection.RIGHT;

        RevHubOrientationOnRobot orientation =
                new RevHubOrientationOnRobot(
                        logoDirection,
                        usbDirection
                );

        imu.initialize(
                new IMU.Parameters(orientation)
        );

        imu.resetYaw();


        // =========================
        // READY
        // =========================

        telemetry.addData("Status", "Ready");
        telemetry.addData("Drive Mode", "ROBOT CENTRIC");
        telemetry.addData("Slow Mode (B)", "OFF");
        telemetry.addData("Intake", "OFF");
        telemetry.addData("Shooter Left (LB)", "OFF");
        telemetry.addData("Shooter Right (RB)", "OFF");
        telemetry.update();

        waitForStart();


        // =========================
        // MAIN LOOP
        // =========================

        while (opModeIsActive()) {


            // =========================
            // FIELD / ROBOT CENTRIC
            // =========================

            if (gamepad1.y && !lastY) {

                fieldCentric = !fieldCentric;

                // Reset yaw όταν μπαίνουμε σε Field Centric
                if (fieldCentric) {
                    imu.resetYaw();
                }
            }

            lastY = gamepad1.y;


            // =========================
            // INTAKE ON / OFF
            // =========================

            if (gamepad1.x && !lastX) {
                intakeOn = !intakeOn;
            }

            lastX = gamepad1.x;

            intakeMotor.setPower(intakeOn ? 1.0 : 0.0);


            // =========================
            // SHOOTER LEFT ON / OFF (LB)
            // =========================

            if (gamepad1.left_bumper && !lastLB) {
                shooterLeftOn = !shooterLeftOn;

                // Όταν ανοίγει: μηδένισε τα στατιστικά και ξεκίνα χρονόμετρο
                if (shooterLeftOn) {
                    shooterLeftTimer.reset();
                    shooterLeftPeakRpm = 0;
                    shooterLeftPeakCurrent = 0;
                    shooterLeftSpinUpTime = -1;
                    shooterLeftStartTicks = shooterLeft.getCurrentPosition();
                }
            }

            lastLB = gamepad1.left_bumper;

            shooterLeft.setPower(shooterLeftOn ? SHOOTER_POWER : 0.0);


            // =========================
            // SHOOTER RIGHT ON / OFF (RB)
            // =========================

            if (gamepad1.right_bumper && !lastRB) {
                shooterRightOn = !shooterRightOn;
            }

            lastRB = gamepad1.right_bumper;

            shooterRight.setPower(shooterRightOn ? SHOOTER_POWER : 0.0);


            // =========================
            // SERVOS - D-PAD
            // =========================

            if (gamepad1.dpad_up && !lastUp) {
                servo1Active = !servo1Active;
            }
            lastUp = gamepad1.dpad_up;

            if (gamepad1.dpad_down && !lastDown) {
                servo2Active = !servo2Active;
            }
            lastDown = gamepad1.dpad_down;

            if (gamepad1.dpad_right && !lastRight) {
                servo3Active = !servo3Active;
            }
            lastRight = gamepad1.dpad_right;

            if (gamepad1.dpad_left && !lastLeft) {
                servo4Active = !servo4Active;
            }
            lastLeft = gamepad1.dpad_left;

            servo1.setPosition(servo1Active ? SERVO_ACTIVE : SERVO_REST);
            servo2.setPosition(servo2Active ? SERVO_ACTIVE : SERVO_REST);
            servo3.setPosition(servo3Active ? SERVO_ACTIVE : SERVO_REST);
            servo4.setPosition(servo4Active ? SERVO_ACTIVE : SERVO_REST);


            // =========================
            // JOYSTICKS
            // =========================

            double x = gamepad1.left_stick_x;

            double y = -gamepad1.left_stick_y;

            double rx = gamepad1.right_stick_x;


            // =========================
            // SLOW MODE
            // =========================

            /*
             * Κάθε πάτημα του B αλλάζει ON <-> OFF:
             *   - ON: αργή κίνηση -> SLOW_DRIVE, αργή στροφή -> SLOW_TURN
             *   - OFF: κανονική ταχύτητα 100%
             */

            if (gamepad1.b && !lastB) {
                slowMode = !slowMode;
            }

            lastB = gamepad1.b;

            double driveSpeed;
            double turn;

            if (slowMode) {

                driveSpeed = SLOW_DRIVE;
                turn = rx * SLOW_TURN;

            } else {

                driveSpeed = 1.0;
                turn = rx;
            }


            // =========================
            // DRIVE
            // =========================

            if (fieldCentric) {

                double heading = imu
                        .getRobotYawPitchRollAngles()
                        .getYaw(AngleUnit.DEGREES);

                drive.driveFieldCentric(
                        x * driveSpeed,
                        y * driveSpeed,
                        turn,
                        heading
                );

            } else {

                drive.driveRobotCentric(
                        x * driveSpeed,
                        y * driveSpeed,
                        turn
                );
            }


            // =========================
            // SHOOTER LEFT - ΥΠΟΛΟΓΙΣΜΟΙ ΠΑΡΑΚΟΛΟΥΘΗΣΗΣ
            // =========================

            double slTicksPerSec = shooterLeft.getVelocity();
            double slRpm = Math.abs(slTicksPerSec) * 60.0 / SHOOTER_TICKS_PER_REV;
            int slTicks = shooterLeft.getCurrentPosition();
            double slCurrent = shooterLeft.getCurrent(CurrentUnit.AMPS);

            if (shooterLeftOn) {

                if (slRpm > shooterLeftPeakRpm) {
                    shooterLeftPeakRpm = slRpm;
                }

                if (slCurrent > shooterLeftPeakCurrent) {
                    shooterLeftPeakCurrent = slCurrent;
                }

                // Θεωρούμε "έφτασε σε ταχύτητα" όταν περάσει το 95% του θεωρητικού max
                // (θεωρητικό max από το motor σου - άλλαξέ το αν χρειάζεται)
                final double SHOOTER_MAX_RPM = 6000;
                if (shooterLeftSpinUpTime < 0 && slRpm >= 0.95 * SHOOTER_MAX_RPM) {
                    shooterLeftSpinUpTime = shooterLeftTimer.seconds();
                }
            }


            // =========================
            // TELEMETRY
            // =========================

            telemetry.addData(
                    "Drive Mode",
                    fieldCentric
                            ? "FIELD CENTRIC"
                            : "ROBOT CENTRIC"
            );

            telemetry.addData(
                    "Slow Mode (B)",
                    slowMode
                            ? "ON - 30%"
                            : "OFF - 100%"
            );

            telemetry.addData(
                    "Intake (X)",
                    intakeOn ? "ON" : "OFF"
            );

            // Shooter left: μόνο ticks και RPM
            telemetry.addData("Shooter Left ticks", slTicks);
            telemetry.addData("Shooter Left RPM", "%.0f", slRpm);

            telemetry.addData(
                    "Shooter Right (RB)",
                    shooterRightOn ? "ON" : "OFF"
            );

            // Δείχνει και την πραγματική θέση που έχει στείλει το servo
            telemetry.addData("Servo1 (UP)",
                    (servo1Active ? "ACTIVE" : "REST")
                            + "  pos=" + String.format("%.2f", servo1.getPosition()));
            telemetry.addData("Servo2 (DOWN)",
                    (servo2Active ? "ACTIVE" : "REST")
                            + "  pos=" + String.format("%.2f", servo2.getPosition()));
            telemetry.addData("Servo3 (RIGHT)",
                    (servo3Active ? "ACTIVE" : "REST")
                            + "  pos=" + String.format("%.2f", servo3.getPosition()));
            telemetry.addData("Servo4 (LEFT)",
                    (servo4Active ? "ACTIVE" : "REST")
                            + "  pos=" + String.format("%.2f", servo4.getPosition()));


            if (fieldCentric) {

                double heading = imu
                        .getRobotYawPitchRollAngles()
                        .getYaw(AngleUnit.DEGREES);

                telemetry.addData(
                        "Heading",
                        "%.1f°",
                        heading
                );
            }

            telemetry.update();
        }

        // Σταμάτα τα motors όταν τελειώσει το OpMode
        intakeMotor.setPower(0);
        shooterLeft.setPower(0);
        shooterRight.setPower(0);
    }
}
